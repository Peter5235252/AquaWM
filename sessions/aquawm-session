#!/bin/sh
# aquawm-session: login-manager entry point for AquaWM.
#
# Display managers (GDM, SDDM, Plasma Login Manager, ly, greetd/tuigreet)
# run the Exec line of the aquawm.desktop session file, which points here.
# Using a wrapper instead of the binary keeps one file working for
# /usr/local, distro package, and nix profile installs alike: aquawm just
# needs to be on PATH (on NixOS the package wraps this script with its own
# bin dir prefixed, so it resolves even under a bare DM environment).
#
# No arguments are expected; extra arguments (like a config path) still
# pass through to the compositor if a manager ever supplies them.

export XDG_CURRENT_DESKTOP=aquawm

# xkbcommon finds its keyboard description database via XKB_CONFIG_ROOT,
# falling back to a compiled-in path that does not exist on NixOS. When
# unset, point it at the system location if present; without this, keys
# silently stop translating into characters. No-op everywhere else.
if [ -z "$XKB_CONFIG_ROOT" ] && [ -d /run/current-system/sw/share/X11/xkb ]; then
    export XKB_CONFIG_ROOT=/run/current-system/sw/share/X11/xkb
fi

# Compositor and client output (spawn errors, kitty GPU errors) goes to
# a per-login file: display managers do not forward session stderr
# anywhere debuggable, and without this a failing session is a black
# screen with no trace. Overwritten on every login (last session only).
logdir="${XDG_DATA_HOME:-$HOME/.local/share}/aquawm"
mkdir -p "$logdir" 2>/dev/null

# Polkit authentication agent (graphical pkexec approval): bare sessions
# start no agent, so pkexec falls back to a textual prompt that has no
# terminal here. Launch once the compositor socket exists (the DM
# environment has no WAYLAND_DISPLAY yet; the compositor takes the first
# free socket). Best-effort and silent when the agent binary is absent
# (distros without polkit-gnome, or DEs shipping their own agent).
if command -v polkit-gnome-authentication-agent-1 >/dev/null 2>&1; then
    (
        uid_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
        disp="${WAYLAND_DISPLAY:-wayland-0}"
        for _ in $(seq 1 100); do
            if [ -S "$uid_runtime/$disp" ]; then
                WAYLAND_DISPLAY="$disp" \
                    exec polkit-gnome-authentication-agent-1 >/dev/null 2>&1
            fi
            sleep 0.2
        done
    ) &
fi

exec aquawm "$@" 2>"$logdir/session.log"
